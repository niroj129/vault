# Automatic HTTPS for every casino site you sell.
# Point a client's domain (A record) at this server and add it in the
# Platform panel; Caddy asks Django whether the domain belongs to a site and,
# if so, fetches a Let's Encrypt certificate on the first visit.
{
	on_demand_tls {
		ask http://backend:8000/api/platform/domain-check/
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip

	# Uploaded images + collected static, served from shared volumes
	handle /media/* {
		root * /srv
		file_server
	}
	handle /static/* {
		root * /srv
		file_server
	}

	# Django API / admin / messenger websockets
	@api path /api/* /api-auth/* /django-admin/* /ws/*
	handle @api {
		reverse_proxy backend:8000
	}

	# Everything else → Next.js
	handle {
		reverse_proxy frontend:3000
	}
}

# Plain HTTP → HTTPS
http:// {
	redir https://{host}{uri} permanent
}

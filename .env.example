# ===== Casino platform — deployment environment =====
# Copy to ".env" and fill in.  cp .env.example .env

# Public base URL that users visit. Same origin serves the site AND /api.
#   • before you have a domain:  http://YOUR_SERVER_IP
#   • with a domain + HTTPS:     https://yourdomain.com
PUBLIC_URL=http://YOUR_SERVER_IP

# Comma-separated hostnames Django will answer to (or * to allow all).
ALLOWED_HOSTS=*

# Django secret — generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Postgres
POSTGRES_DB=tiffany
POSTGRES_USER=tiffany
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Set to 1 only AFTER you've enabled HTTPS (otherwise logins break on http).
COOKIE_SECURE=0

# Seed demo games/content and the first admin on first boot (set 0 after the first deploy).
SEED=1
# Password for the first admin (the platform owner). Required on a live server; if you
# leave it empty a random one is generated and printed once in the backend log.
ADMIN_PASSWORD=
# 1 also creates demo logins (agent / agent123, user / user123). Never on a live server.
SEED_DEMO_USERS=0

# Unknown hostnames serve the platform site (1). Set 0 once every client
# domain is added in the Platform panel, so stray domains get a 404.
TENANT_FALLBACK=1

# Web Push notifications — generate once with:
#   docker compose exec backend python manage.py vapid_keys
# (without these, keys are regenerated on every fresh container and
# players must re-enable notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
